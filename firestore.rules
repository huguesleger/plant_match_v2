rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(keys) {
      return changedKeys().hasOnly(keys);
    }

    function isParty(data) {
      return isUser(data.ownerId) || isUser(data.requestedBy);
    }

    function inChatId(data) {
      return signedIn() && request.auth.uid in data.chatId.split('_');
    }

    function chatOf(chatId) {
      return get(/databases/$(database)/documents/plant_chats/$(chatId)).data;
    }

    function plantOwner(plantId) {
      return get(/databases/$(database)/documents/catalogs/$(plantId)).data.userId;
    }

    // chatId = <plantId>_<uidA>_<uidB> (uids triés)
    function validNewChat(chatId, data) {
      let parts = chatId.split('_');
      return parts.size() == 3
        && parts[1] != parts[2]
        && data.participants.hasOnly([parts[1], parts[2]])
        && data.participants.hasAll([parts[1], parts[2]])
        && data.plantId == parts[0]
        && data.plantOwnerId == plantOwner(parts[0])
        && data.plantOwnerId in data.participants;
    }

    // Une transaction doit lier deux parties distinctes d'une même
    // conversation, et le propriétaire doit posséder la plante demandée.
    function validNewTransaction(data, ownedPlantId) {
      return isUser(data.requestedBy)
        && data.ownerId != data.requestedBy
        && data.ownerId == plantOwner(ownedPlantId)
        && data.ownerId in chatOf(data.chatId).participants
        && data.requestedBy in chatOf(data.chatId).participants
        && data.status == 'pending'
        && data.get('validationCode', null) == null;
    }

    function isBlockedBy(blocker, blocked) {
      return exists(/databases/$(database)/documents/users/$(blocker)/blocked_users/$(blocked));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.get('leaves', 5) == 5
        && request.resource.data.get('referredBy', null) == null;
      allow update: if isUser(uid)
        && !changedKeys().hasAny(['leaves', 'referredBy', 'referralCode']);
      allow delete: if false;

      match /blocked_users/{blockedId} {
        allow read: if isUser(uid) || isUser(blockedId);
        allow write: if isUser(uid);
      }

      match /favorites_plants/{docId} {
        allow read, write: if isUser(uid);
      }

      match /favorites_users/{docId} {
        allow read, write: if isUser(uid);
      }
    }

    match /userPoints/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.currentPoints == 0
        && request.resource.data.level == 1;
      allow update, delete: if false;
    }

    match /catalogs/{catalogId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('views', 0) == 0;
      allow update: if (
          isUser(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && !changedKeys().hasAny(['views'])
        ) || (
          signedIn()
          && onlyChanged(['views'])
          && request.resource.data.views == resource.data.get('views', 0) + 1
        );
      allow delete: if isUser(resource.data.userId);
    }

    match /plant_chats/{chatId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && validNewChat(chatId, request.resource.data)
        && !request.resource.data.keys().hasAny(
          ['contactPaid', 'isDonationCompleted', 'isExchangeCompleted',
           'lastMessage']
        );
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && !changedKeys().hasAny([
          'contactPaid', 'isDonationCompleted', 'isExchangeCompleted',
          'participants', 'plantOwnerId', 'plantId'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in chatOf(chatId).participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in chatOf(chatId).participants
          && request.resource.data.receiverId in chatOf(chatId).participants
          && !isBlockedBy(request.resource.data.receiverId, request.auth.uid)
          && !isBlockedBy(request.auth.uid, request.resource.data.receiverId)
          && (
            chatOf(chatId).get('contactPaid', false) == true
            || chatOf(chatId).get('plantOwnerId', '') == request.auth.uid
          );
        allow update: if isUser(resource.data.receiverId)
          && onlyChanged(['readAt']);
        allow delete: if false;
      }
    }

    match /plant_donations/{donationId} {
      allow read: if isParty(resource.data) || inChatId(resource.data);
      allow create: if validNewTransaction(
        request.resource.data, request.resource.data.plantId
      );
      allow update: if (
          isUser(resource.data.ownerId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && onlyChanged(['status', 'seenByRequester', 'seenByOwner'])
        ) || (
          isUser(resource.data.ownerId) && onlyChanged(['seenByOwner'])
        ) || (
          isUser(resource.data.requestedBy) && onlyChanged(['seenByRequester'])
        );
      allow delete: if false;

      match /private/{docId} {
        allow read: if isUser(
          get(/databases/$(database)/documents/plant_donations/$(donationId)).data.ownerId
        );
        allow write: if false;
      }
    }

    match /plant_exchanges/{exchangeId} {
      allow read: if isParty(resource.data) || inChatId(resource.data);
      allow create: if validNewTransaction(
          request.resource.data, request.resource.data.targetPlantId
        )
        && plantOwner(request.resource.data.offeredPlantId)
          == request.resource.data.requestedBy;
      allow update: if (
          isUser(resource.data.ownerId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && onlyChanged(['status', 'seenByRequester', 'seenByOwner'])
        ) || (
          isUser(resource.data.ownerId) && onlyChanged(['seenByOwner'])
        ) || (
          isUser(resource.data.requestedBy) && onlyChanged(['seenByRequester'])
        );
      allow delete: if false;

      match /private/{docId} {
        allow read: if isUser(
          get(/databases/$(database)/documents/plant_exchanges/$(exchangeId)).data.ownerId
        );
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /user_recommendations/{uid} {
      allow read, write: if isUser(uid);
    }
  }
}
